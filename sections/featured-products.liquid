{%- assign col = collections[section.settings.collection] -%}
{%- if col.products.size > 0 -%}
<section class="section-pad">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    </div>
    <div class="card-grid">
      {%- for product in col.products limit: section.settings.products_to_show -%}
        <a class="product-card reveal" href="{{ product.url }}">
          <div class="card-media">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | escape }}" width="700" loading="lazy">
            {%- else -%}
              <div class="card-media--empty">{{ product.title | slice: 0 }}</div>
            {%- endif -%}
            {%- if product.compare_at_price > product.price -%}<span class="badge-sale">Sale</span>{%- endif -%}
            <div class="card-label"><span class="btn btn--light">View</span></div>
          </div>
          <h3 class="card-title">{{ product.title }}</h3>
          <p class="card-price">
            {%- if product.compare_at_price > product.price -%}<span class="compare">{{ product.compare_at_price | money }}</span>{%- endif -%}
            {{ product.price | money }}
          </p>
        </a>
      {%- endfor -%}
    </div>
    {%- if section.settings.show_view_all -%}
      <div class="section-head" style="margin:40px 0 0">
        <a class="btn btn--outline" href="{{ col.url }}">View All</a>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Products" },
    { "type": "collection", "id": "collection", "label": "Collection", "default": "all" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View All button", "default": true }
  ],
  "presets": [ { "name": "Featured products" } ]
}
{% endschema %}