<section class="section-pad">
  <div class="wrap">
    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <h1>Your Bag Is Empty</h1>
        <p>Discover the collection and find your next piece.</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">Shop Now</a>
      </div>
    {%- else -%}
      <div class="page-head" style="padding-top:0">
        <h1>Your Bag</h1>
      </div>
      <form action="{{ routes.cart_url }}" method="post">
        <table class="cart-table">
          <thead>
            <tr><th>Item</th><th>Price</th><th>Qty</th><th>Total</th></tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <div class="cart-item">
                    {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="200">{%- endif -%}
                    <div>
                      <a class="ci-title" href="{{ item.url }}">{{ item.product.title }}</a>
                      {%- unless item.product.has_only_default_variant -%}<div class="ci-variant">{{ item.variant.title }}</div>{%- endunless -%}
                      <a class="remove" href="{{ item.url_to_remove }}">Remove</a>
                    </div>
                  </div>
                </td>
                <td>{{ item.final_price | money }}</td>
                <td><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.title | escape }}"></td>
                <td>{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart-footer">
          <div class="cart-summary">
            <div class="row"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
            <p class="note">Shipping and Cash on Delivery confirmed at checkout.</p>
            <button type="submit" name="update" class="btn btn--outline btn--block">Update Bag</button>
            <div style="height:12px"></div>
            <button type="submit" name="checkout" class="btn btn--block">Checkout</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}