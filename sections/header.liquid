<header class="site-header">
  {%- if settings.announcement != blank -%}
    <div class="announcement">{{ settings.announcement }}</div>
  {%- endif -%}

  <div class="header-main">
    <button class="menu-toggle" aria-expanded="false" aria-controls="HeaderMenu" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>

    <div class="header-logo">
      <a href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name | escape }}" width="150" loading="eager">
        {%- else -%}
          <span class="logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <nav class="header-menu" id="HeaderMenu" aria-label="Primary">
      <ul>
        {%- assign menu = linklists[section.settings.menu].links -%}
        {%- if menu.size > 0 -%}
          {%- for link in menu -%}
            <li><a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
          <li><a href="{{ routes.search_url }}">Search</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <div class="header-icons">
      <a href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
        <span class="lbl">Search</span>
      </a>
      <a href="{{ routes.account_url }}" aria-label="Account">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        <span class="lbl">Account</span>
      </a>
      <a href="{{ routes.cart_url }}" aria-label="Cart">
        <svg viewBox="0 0 24 24"><path d="M6 8h12l-1 13H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <span class="lbl">Bag</span>
        <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}