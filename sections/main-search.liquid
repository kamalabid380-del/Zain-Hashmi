<div class="page-head">
  <span class="eyebrow">Search</span>
  <h1>{% if search.performed %}Results{% else %}Search the Collection{% endif %}</h1>
</div>

<section class="section-pad" style="padding-top:0">
  <div class="wrap">
    <form class="search-bar" method="get" action="{{ routes.search_url }}" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search pieces, collections..." aria-label="Search">
      <button type="submit" class="btn">Search</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        {%- paginate search.results by 12 -%}
          <div class="card-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <a class="product-card reveal" href="{{ item.url }}">
                  <div class="card-media">
                    {%- if item.featured_image -%}
                      <img src="{{ item.featured_image | image_url: width: 700 }}" alt="{{ item.featured_image.alt | escape }}" width="700" loading="lazy">
                    {%- else -%}
                      <div class="card-media--empty">{{ item.title | slice: 0 }}</div>
                    {%- endif -%}
                    <div class="card-label"><span class="btn btn--light">View</span></div>
                  </div>
                  <h3 class="card-title">{{ item.title }}</h3>
                  <p class="card-price">{{ item.price | money }}</p>
                </a>
              {%- else -%}
                <a class="product-card reveal" href="{{ item.url }}">
                  <h3 class="card-title">{{ item.title }}</h3>
                  <p class="card-price">{{ item.content | strip_html | truncate: 90 }}</p>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="Pagination">
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>{%- endif -%}
              {%- endfor -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="empty-state">
          <h1>No Matches</h1>
          <p>Nothing found for &ldquo;{{ search.terms | escape }}&rdquo;. Try a different word.</p>
          <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}">Browse All</a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}