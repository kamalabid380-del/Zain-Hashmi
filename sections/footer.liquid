<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-column">
      <h3>{{ shop.name }}</h3>
      <p>{{ section.settings.footer_about }}</p>
      <p>📍 Lahore, Punjab, Pakistan</p>
      <p>📞 +92 300 1234567</p>
      <p>✉️ support@zainhashmi.com</p>
    </div>

    <div class="footer-column">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/collections/all">Shop All</a></li>
        <li><a href="/pages/about-us">About Us</a></li>
        <li><a href="/pages/contact">Contact Us</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h4>Customer Service</h4>
      <ul>
        <li><a href="/pages/shipping-policy">Shipping Policy</a></li>
        <li><a href="/pages/return-policy">Return & Exchange</a></li>
        <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
        <li><a href="/pages/terms-of-service">Terms of Service</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h4>Follow Us</h4>
      <ul>
        <li><a href="https://instagram.com/zainhashmi" target="_blank">Instagram</a></li>
        <li><a href="https://facebook.com/zainhashmi" target="_blank">Facebook</a></li>
        <li><a href="https://tiktok.com/@zainhashmi" target="_blank">TikTok</a></li>
        <li><a href="https://wa.me/923001234567" target="_blank">WhatsApp</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All Rights Reserved.</p>
    <p>Cash on Delivery Available All Over Pakistan</p>
  </div>
</footer>

<style>
.site-footer { background: #111; color: #fff; padding: 40px 20px 20px; margin-top: 40px; }
.footer-main { display: flex; flex-wrap: wrap; gap: 30px; max-width: 1200px; margin: 0 auto; }
.footer-column { flex: 1; min-width: 200px; }
.footer-column h3, .footer-column h4 { margin-bottom: 15px; }
.footer-column ul { list-style: none; padding: 0; }
.footer-column ul li { margin-bottom: 8px; }
.footer-column a { color: #ddd; text-decoration: none; }
.footer-column a:hover { color: #fff; text-decoration: underline; }
.footer-bottom { text-align: center; border-top: 1px solid #333; margin-top: 30px; padding-top: 20px; font-size: 14px; color: #aaa; }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "footer_about",
      "label": "About Text",
      "default": "Zain Hashmi - Premium Quality Products with Fast Delivery All Over Pakistan. Trusted by thousands of customers."
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
