<section class="section-pad" style="background:var(--canvas)">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    </div>
    <div class="testimonial-grid">
      {%- for block in section.blocks -%}
        <figure class="testimonial reveal" {{ block.shopify_attributes }}>
          <div class="t-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <blockquote>&ldquo;{{ block.settings.quote }}&rdquo;</blockquote>
          <figcaption>
            <span class="t-name">{{ block.settings.name }}</span><br>
            <span class="t-city">{{ block.settings.city }}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our People" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The fabric and stitching exceeded my expectations. Delivered quickly and the fit was perfect." },
        { "type": "text", "id": "name", "label": "Name", "default": "Ayesha K." },
        { "type": "text", "id": "city", "label": "City", "default": "Lahore" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [ { "type": "quote" }, { "type": "quote" }, { "type": "quote" } ]
    }
  ]
}
{% endschema %}