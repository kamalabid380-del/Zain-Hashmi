<div class="collection-hero">
  <span class="eyebrow">Collection</span>
  <h1>{{ collection.title }}</h1>
  {%- if collection.description != blank -%}<p>{{ collection.description }}</p>{%- endif -%}
</div>

<section class="section-pad" style="padding-top:0">
  <div class="wrap">
    <div class="toolbar">
      <span class="count">{{ collection.products_count }} pieces</span>
      <form method="get" action="{{ collection.url }}">
        <label class="count" for="SortBy">Sort</label>
        <select name="sort_by" id="SortBy" onchange="this.form.submit()">
          {%- assign sort = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>

    {%- paginate collection.products by 12 -%}
      <div class="card-grid">
        {%- for product in collection.products -%}
          <a class="product-card reveal" href="{{ product.url }}">
            <div class="card-media">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | escape }}" width="700" loading="lazy">
              {%- else -%}
                <div class="card-media--empty">{{ product.title | slice: 0 }}</div>
              {%- endif -%}
              {%- if product.compare_at_price > product.price -%}<span class="badge-sale">Sale</span>{%- endif -%}
              <div class="card-label"><span class="btn btn--light">View</span></div>
            </div>
            <h3 class="card-title">{{ product.title }}</h3>
            <p class="card-price">{{ product.price | money }}</p>
          </a>
        {%- else -%}
          <p class="count">No pieces in this collection yet.</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}