<section class="hero">
  <div class="hero-media{% unless section.settings.hero_image != blank %} hero-media--fallback{% endunless %}">
    {%- if section.settings.hero_image != blank -%}
      <img src="{{ section.settings.hero_image | image_url: width: 2000 }}" alt="{{ section.settings.heading | escape }}" width="2000" loading="eager" fetchpriority="high">
    {%- endif -%}
  </div>
  <div class="hero-scrim"></div>

  <div class="hero-content">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.sub_heading }}</p>
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn--light">{{ section.settings.button_text }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Haute Couture '25" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Zain Hashmi" },
    { "type": "text", "id": "sub_heading", "label": "Sub heading", "default": "New Arrivals | Best Quality | Fast Delivery" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/collections/all" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}